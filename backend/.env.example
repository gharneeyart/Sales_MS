NODE_ENV=development
PORT=4000

# Use a dedicated non-superuser Postgres role for this app — RLS policies
# (A.3) are silently bypassed for superusers and table owners without
# FORCE ROW LEVEL SECURITY, so local dev needs the same restricted role
# production would use for RLS to mean anything.
DATABASE_URL=postgres://sales_dashboard_app:password@localhost:5432/sales_dashboard_dev
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_INVITE_SECRET=replace-with-another-random-secret

# From your Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://replace-with-your-credentials

# Optional — leave unset locally, Sentry stays off
SENTRY_DSN=

# Paystack test-mode secret key (dashboard → Settings → API Keys & Webhooks).
# Point Paystack's webhook URL at POST /api/billing/webhook so it can reach
# this backend (e.g. via an ngrok tunnel in local dev).
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_key

# Where Paystack redirects the browser after checkout, and where invite/
# billing links in emails point. Defaults to the Vite dev server.
FRONTEND_URL=http://localhost:5173
